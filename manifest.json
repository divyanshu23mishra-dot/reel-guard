{
  "manifest_version": 3,
  "name": "ScrollFit — A fitness tracker for your attention",
  "short_name": "ScrollFit",
  "version": "0.1.0",
  "description": "Tracks how many Instagram Reels you watch each day and helps you stay within your own limit.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": [
        "shared/types.js",
        "shared/storage.js",
        "shared/scoring.js",
        "content/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": ["https://www.instagram.com/*"],
  "options_page": "dashboard/dashboard.html"
}
